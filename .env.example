# =============================================================================
# eLearning AgroAmérica — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
# =============================================================================

# --- Database (Oracle 19c) ---
# En producción usar el schema ELEARNING (ver db/SOLICITUD-ORACLE.md)
DB_HOST=oracle-host
DB_PORT=1521
DB_SID=ORCL
DB_USER=ELEARNING
DB_PASSWORD=change_me_db_password
DB_USE_SID=true
# Alternativa: connection string completa (tiene prioridad)
# DB_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=host)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))

# --- JWT ---
JWT_SECRET=change_me_jwt_secret_at_least_64_chars
JWT_EXPIRES_IN=24h

# --- Active Directory / LDAP ---
LDAP_URL=ldaps://your-ad-server:636
LDAP_BIND_DN=CN=svc_centinela,OU=ServiceAccounts,DC=agroamerica,DC=com
LDAP_BIND_PASSWORD=change_me_ldap_password
LDAP_SEARCH_BASE=DC=agroamerica,DC=com
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person))
LDAP_PAGE_SIZE=500
LDAP_DRY_RUN=false

# --- SMTP (for phishing simulations and notifications) ---
SMTP_HOST=smtp.agroamerica.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@agroamerica.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM="eLearning AgroAmérica <noreply@agroamerica.com>"

# --- Base URL ---
BASE_URL=http://localhost:3000

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=change_me_tunnel_token

# --- AWS S3 Storage ---
# En producción con EC2 + IAM Role: no necesita ACCESS_KEY ni SECRET_KEY
# (el SDK usa el rol de la instancia automáticamente).
# Solo definir keys si se corre fuera de AWS o con MinIO local.
AWS_REGION=us-east-1
S3_BUCKET=elearning-agroamerica-storage
# AWS_ACCESS_KEY_ID=         (solo para desarrollo local sin IAM Role)
# AWS_SECRET_ACCESS_KEY=     (solo para desarrollo local sin IAM Role)
# S3_ENDPOINT=http://localhost:9000  (solo para MinIO local)

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Environment ---
NODE_ENV=development

# --- Admin Seed ---
ADMIN_EMAIL=admin@agroamerica.com
ADMIN_PASSWORD=Admin123!
